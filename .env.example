# Terrion_Frontend — konfigurasi contoh.
#
#   cp .env.example .env.local
#
# Hanya ada satu setelan, dan itu memang seluruhnya. Antarmuka ini tidak
# menyentuh basis data, tidak memegang kunci Supabase, dan tidak pernah
# memanggil layanan AI — semuanya lewat Terrion_Backend.


# Alamat Terrion_Backend.
#
# Awalan NEXT_PUBLIC_ berarti nilai ini ikut dipanggang ke dalam bundel
# peramban, jadi dua hal berlaku: ia harus alamat yang bisa dijangkau dari
# peramban pengguna (bukan "localhost" di dalam Docker, bukan nama service
# internal), dan ia BUKAN rahasia. Jangan pernah menaruh kunci di variabel
# ber-awalan NEXT_PUBLIC_.
#
# Lokal, dengan backend berjalan di port bawaannya:
NEXT_PUBLIC_API_URL=http://localhost:8080
#
# Produksi, contoh:
# NEXT_PUBLIC_API_URL=https://terrion-backend.up.railway.app


# Tidak ada setelan layanan AI di sini, dan itu disengaja.
#
# Terrion_AI hanya dipanggil server-ke-server oleh Terrion_Backend, dengan
# bearer token yang tidak boleh menyentuh peramban. Setelan AI_SERVICE_URL dan
# AI_SERVICE_TOKEN hidup di .env milik Terrion_Backend.
