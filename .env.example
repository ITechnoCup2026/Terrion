# Copy to .env (or .env.local) and fill in. Both are gitignored.

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase → Project Settings → API Keys → anon / public
# Safe to expose: every table it can reach is protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API Keys → service_role
# Bypasses RLS entirely. Imported only by the weather cron route and the
# demo generator — an accidental import into a page silently disables tenancy.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the daily weather cron. Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# --- Local tooling only. Not read by the app; never set in deployment. ---

# Supabase → Account → Access Tokens (https://supabase.com/dashboard/account/tokens)
# Lets the CLI link and generate types without an interactive browser login:
#   pnpm supabase link --project-ref <project-ref>
#   pnpm supabase gen types typescript --linked > lib/supabase/types.gen.ts

# Alternative if you would rather not mint a token: use the connection string
# from Project Settings → Database with `gen types typescript --db-url "..."`.
SUPABASE_ACCESS_TOKEN=
